# ---- identity -------------------------------------------------------------
SITE_NAME=Rebel Creamery
SITE_TAGLINE=Small-batch dairy, made in Calgary.
CONTACT_EMAIL=hello@rebelcreamery.ca
CONTACT_PHONE=
INSTAGRAM=
PUBLIC_BASE_URL=https://shop.example.ca

# ---- pickup / delivery ----------------------------------------------------
PICKUP_LOCATION=1008 9 St SW, Calgary, AB T2R 1B1
PICKUP_WINDOW=Saturdays, 9 am – 2 pm
CUTOFF_TEXT=Order by Thursday 6 pm for weekend pickup
DELIVERY_FEE_CENTS=800
FREE_DELIVERY_THRESHOLD_CENTS=4000
DELIVERY_AREA=Calgary city limits
DELIVERY_WINDOWS=Fridays, 12 – 6 pm
LICENCE_TEXT=Made in Alberta under provincial food-safety rules. Licensing and inspection details available on request.

# ---- payments -------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty + DEMO_MODE=1
# 1 = made to order: stock never blocks an order; use the back-office sold-out switch.
# 0 = sell against counted stock with automatic sold-out at zero.
MADE_TO_ORDER=1 to test the full flow without a Stripe account.
DEMO_MODE=1
# 1 = made to order: stock never blocks an order; use the back-office sold-out switch.
# 0 = sell against counted stock with automatic sold-out at zero.
MADE_TO_ORDER=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ETRANSFER_EMAIL=hello@rebelcreamery.ca

# Order email (Resend). Leave the key empty to disable sending.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g.
# "Rebel Creamery <orders@rebelcreamery.ca>". Until then Resend's shared
# test sender only delivers to the Resend account owner's own address.
EMAIL_FROM=Rebel Creamery <onboarding@resend.dev>
EMAIL_REPLY_TO=hello@rebelcreamery.ca

# ---- labels ---------------------------------------------------------------
# Shared secret for the print agent (see print-agent/README.md).
PRINT_TOKEN=change-me-print-token
# Printed on every label, under the storage line.
BUSINESS_ADDRESS=Rebel Creamery · Calgary, AB

# ---- back office ----------------------------------------------------------
# /admin is HTTP Basic. Use a long random password.
ADMIN_USER=owner
ADMIN_PASSWORD=change-me-use-a-long-random-string
